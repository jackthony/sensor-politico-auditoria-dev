# Identificación del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave

# Datos de la prueba de desarrollo
POLL_ID=tu-poll-id
CANDIDATE_ID=tu-candidate-id
TEST_RUN_ID=entrega-001

# Nombres de las funciones RPC (solo cambia estos si tu backend usa otros nombres)
VOTE_RPC_NAME=submit_scope_vote_v41
RESULTS_RPC_NAME=get_poll_results

# Protección obligatoria para cualquier escritura remota
ENVIRONMENT=development
CONFIRM_DEV_TEST=I_UNDERSTAND_DEV_TEST_WRITES

# Perfil temporal: media de 12 s, jitter de 30 % y mínimo de 1 s
TOTAL_ACCIONES=50
MEDIA_MS=12000
JITTER_PERCENT=30
MIN_INTERVALO_MS=1000
SEMILLA=clase-jitter-lognormal-001

# INTERVALO_MS se conserva como alias de MEDIA_MS para compatibilidad.
